---
import Layout from "@/layouts/Layout.astro";

const { user } = Astro.locals;
---

<Layout title="Panel">
  <div class="bg-kitchen flex min-h-screen items-center justify-center p-4">
    <div class="rounded-2xl border border-amber-900/10 bg-white/70 shadow-sm p-8 text-center text-stone-900 backdrop-blur-xl">
      <h1 class="mb-4 text-3xl font-bold text-stone-900">Panel</h1>
      <p class="text-stone-700">
        Witaj, <span class="font-semibold text-stone-900">{user?.email}</span>
      </p>
      <p class="mt-2 text-sm text-stone-500">Ta strona jest dostępna tylko dla zalogowanych użytkowników.</p>
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="rounded-lg border border-stone-300 bg-white/60 px-4 py-2 text-sm text-stone-800 transition-colors hover:bg-white"
        >
          Wyloguj się
        </button>
      </form>
    </div>
  </div>
</Layout>
