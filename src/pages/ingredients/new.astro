---
import Layout from "@/layouts/Layout.astro";
import IngredientsFooter from "@/components/ingredients/IngredientsFooter.astro";
import SubstituteCreateForm from "@/components/ingredients/SubstituteCreateForm.astro";
import Alert from "@/components/ui/Alert.astro";
import Card from "@/components/ui/Card.astro";
import { buttonVariants } from "@/components/ui/button";
import { focusRing } from "@/components/ui/focus";
import { listRedirect, parseListView } from "@/lib/list-view";
import { createClient } from "@/lib/supabase";
import { listCategories, listIngredients } from "@/lib/services/substitutes";
import { cn } from "@/lib/utils";
import type { Category } from "@/types";

const params = Astro.url.searchParams;
const error = params.get("error");
// Prefill from the list page's empty-state link: ?ingredient=<ingredient id>&category=<category id>[&q&match].
const prefillIngredientId = params.get("ingredient");
// Echoed back by /api/ingredients after a validation error too, so the select keeps the chosen category.
const categoryId = params.get("category") ?? "";
// Values echoed back by /api/ingredients after a validation error, so the user does not retype them.
const echoedIngredientName = params.get("ingredient_name") ?? "";
const echoedSubstitute = params.get("substitute") ?? "";
const echoedRatio = params.get("ratio") ?? "";
const echoedNotes = params.get("notes") ?? "";
const echoedIsBest = params.get("is_best") === "1";
// "Anuluj" returns to the list view the user came from (ingredient + category, q, match); otherwise the bare list.
const cancelHref = listRedirect(parseListView(params));

let categories: Category[] = [];
let ingredientNames: string[] = [];
let loadError: string | null = null;
let prefillIngredientName = "";

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  loadError = "Baza danych nie jest skonfigurowana.";
} else {
  const [categoriesResult, ingredientsResult] = await Promise.all([
    listCategories(supabase),
    listIngredients(supabase),
  ]);
  if (categoriesResult.error !== null) {
    loadError = categoriesResult.error;
  } else {
    categories = categoriesResult.data;
  }

  // The suggestions are a convenience, not a condition for saving: a failed list only leaves them out.
  if (ingredientsResult.error === null) {
    ingredientNames = ingredientsResult.data.map((item) => item.name);
    if (prefillIngredientId) {
      // RLS limits this to the current user's ingredients; an unknown id simply means no prefill.
      prefillIngredientName = ingredientsResult.data.find((item) => item.id === prefillIngredientId)?.name ?? "";
    }
  }
}

const values = {
  ingredient: echoedIngredientName || prefillIngredientName,
  categoryId,
  substitute: echoedSubstitute,
  ratio: echoedRatio,
  notes: echoedNotes,
  isBest: echoedIsBest,
};
---

<Layout title="Dodaj zamiennik">
  <div class="bg-kitchen flex min-h-screen items-center justify-center p-4">
    <Card class="w-full max-w-md rounded-2xl border-border bg-card/70 p-8 text-foreground shadow-sm backdrop-blur-xl">
      <h1 class="mb-6 text-2xl font-bold text-foreground">Dodaj zamiennik</h1>

      {loadError ? (
        <div class="space-y-4">
          <Alert role="alert" variant="destructive">
            {loadError}
          </Alert>
          <a href={cancelHref} class:list={cn(buttonVariants({ variant: "outline" }), focusRing)}>
            Wróć do listy
          </a>
        </div>
      ) : (
        <SubstituteCreateForm
          categories={categories}
          ingredientNames={ingredientNames}
          values={values}
          cancelHref={cancelHref}
          error={error}
        />
      )}

      <IngredientsFooter />
    </Card>
  </div>
</Layout>
