---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Logowanie">
  <div class="bg-kitchen flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-amber-900/10 bg-white/70 shadow-sm p-8 text-stone-900 backdrop-blur-xl">
      <h1 class="mb-6 text-center text-2xl font-bold text-stone-900">Logowanie</h1>
      <SignInForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-stone-600">
        Nie masz konta?{" "}
        <a href="/auth/signup" class="text-orange-700 hover:underline">
          Załóż konto
        </a>
      </p>
    </div>
  </div>
</Layout>
