---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Rejestracja">
  <div class="bg-kitchen flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-amber-900/10 bg-white/70 shadow-sm p-8 text-stone-900 backdrop-blur-xl">
      <h1 class="mb-6 text-center text-2xl font-bold text-stone-900">Rejestracja</h1>
      <SignUpForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-stone-600">
        Masz już konto?{" "}
        <a href="/auth/signin" class="text-orange-700 hover:underline">
          Zaloguj się
        </a>
      </p>
    </div>
  </div>
</Layout>
