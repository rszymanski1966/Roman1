---
import Layout from "@/layouts/Layout.astro";
import Alert from "@/components/ui/Alert.astro";
import Badge from "@/components/ui/Badge.astro";
import Card from "@/components/ui/Card.astro";
import Input from "@/components/ui/Input.astro";
import Label from "@/components/ui/Label.astro";
import NativeSelect from "@/components/ui/NativeSelect.astro";
import { buttonVariants } from "@/components/ui/button";
import { focusRing } from "@/components/ui/focus";
import EmptyState from "@/components/ingredients/EmptyState.astro";
import IngredientsFooter from "@/components/ingredients/IngredientsFooter.astro";
import IngredientsHeader from "@/components/ingredients/IngredientsHeader.astro";
import LookupForms from "@/components/ingredients/LookupForms.astro";
import SubstituteCard from "@/components/ingredients/SubstituteCard.astro";
import { cn } from "@/lib/utils";
import type { Category, IngredientListItem, SubstituteListItem } from "@/types";

// Dev-only visual gate for the ui/ components; no database access.
// The rule crashes on a top-level return in Astro frontmatter (no enclosing function), so it is off for this file.
/* eslint @typescript-eslint/no-misused-promises: "off" */
if (!import.meta.env.DEV) {
  return new Response(null, { status: 404 });
}

const sectionClass = "space-y-4";
const headingClass = "text-lg font-semibold text-foreground";
const stateClass = "text-xs text-muted-foreground";

// Fixtures for the /ingredients view section (local, no database).
const fixtureCategories: Category[] = [
  { id: "00000000-0000-4000-8000-000000000001", slug: "baking", name: "Pieczenie", sort_order: 1 },
  { id: "00000000-0000-4000-8000-000000000002", slug: "cooking", name: "Gotowanie", sort_order: 2 },
];
const fixtureIngredients: IngredientListItem[] = [
  { id: "00000000-0000-4000-8000-000000000011", name: "mąka pszenna" },
  { id: "00000000-0000-4000-8000-000000000012", name: "mąka ziemniaczana" },
  { id: "00000000-0000-4000-8000-000000000013", name: "masło" },
];
const fixtureBest: SubstituteListItem = {
  id: "00000000-0000-4000-8000-000000000021",
  name: "mąka orkiszowa",
  ratio: "1:1",
  notes: "Ciasto wychodzi nieco cięższe.",
  is_best: true,
};
const fixtureRegular: SubstituteListItem = {
  id: "00000000-0000-4000-8000-000000000022",
  name: "mąka gryczana",
  ratio: "3/4 szklanki na 1 szklankę",
  notes: null,
  is_best: false,
};
// Separate ids for the error-state cards: every SubstituteCard root carries id="substitute-<id>", which must stay unique.
const fixtureErrorCard: SubstituteListItem = {
  id: "00000000-0000-4000-8000-000000000023",
  name: "mąka owsiana",
  ratio: "1:1",
  notes: null,
  is_best: false,
};
const fixtureTopErrorCard: SubstituteListItem = {
  id: "00000000-0000-4000-8000-000000000024",
  name: "mąka kukurydziana",
  ratio: "1:1",
  notes: null,
  is_best: false,
};
const fixtureCardError = "Nieprawidłowe dane formularza.";
const fixtureTopError = "Nie znaleziono zamiennika.";
const fixtureIngredient = fixtureIngredients[0];
const fixtureMatches = fixtureIngredients.slice(0, 2);
// Same text-link classes as src/pages/ingredients/index.astro (the matches list lives in the page).
const textLinkClass = cn(buttonVariants({ variant: "link" }), focusRing, "h-auto p-0 whitespace-normal");
const viewFrameClass = "bg-kitchen rounded-2xl p-4";
const viewCardClass = "rounded-2xl border-border bg-card/70 p-8 text-foreground shadow-sm backdrop-blur-xl";
// Focus-visible forced for a screenshot: the classes of focusRing / focusOutline without the variant prefix.
const forcedRing = "border-ring ring-3 ring-ring";
const forcedOutline = "outline-2 outline-offset-2 outline-ring";
const matrixCellClass = "border-b border-border px-3 py-2 align-top";

// The 7-state matrix of /ingredients: what the view does in each state and where this page shows it.
const stateMatrix = [
  { state: "default", view: "Widok na tokenach motywu kitchen.", here: "Sekcja „Widok /ingredients” niżej." },
  {
    state: "hover",
    view: "Przyciski default: tło primary/90; outline: tło accent; linki tekstowe: podkreślenie.",
    here: "Najedź kursorem na przyciski i linki w sekcjach „Przyciski” i „Widok /ingredients”.",
  },
  {
    state: "focus-visible",
    view: "Pierścień ring-3 z tokenu ring przy pełnym kryciu (pola, selecty, przyciski, linki); radio: obrys outline-ring.",
    here: "Tab po stronie albo wiersz „Focus-visible (wymuszony do zrzutu)” niżej.",
  },
  {
    state: "disabled",
    view: "N/A: widok nie ma kontrolek, które mogą być nieaktywne; formularze robią pełne przeładowanie strony.",
    here: "Disabled Button, Input i NativeSelect w sekcjach komponentów wyżej.",
  },
  {
    state: "error",
    view: "Błąd akcji „najlepszy” w karcie (error_for); gdy karty nie ma, Alert destructive na górze. Pole z aria-invalid.",
    here: "Karta z błędem i błąd na górze niżej; pola z aria-invalid w sekcjach komponentów wyżej.",
  },
  {
    state: "empty",
    view: "4 puste stany: brak składników, stan początkowy, brak dopasowań, brak zamienników.",
    here: "Ramka „Puste stany” niżej.",
  },
  {
    state: "loading",
    view: "N/A: SSR, widok bez <script>, nic nie dociąga się po renderze.",
    here: "Brak (nic do pokazania).",
  },
];
---

<Layout title="Kitchen sink">
  <main class="min-h-screen bg-background p-4 text-foreground md:p-8">
    <div class="mx-auto w-full max-w-3xl space-y-10">
      <header class="space-y-2">
        <h1 class="text-2xl font-bold">Kitchen sink</h1>
        <p class="text-sm text-muted-foreground">
          Komponenty z <code>src/components/ui/</code> we wszystkich stanach. Hover: najedź kursorem. Focus-visible:
          przejdź po stronie klawiszem Tab.
        </p>
      </header>

      <section class:list={sectionClass}>
        <h2 class:list={headingClass}>Pole tekstowe (Input + Label)</h2>
        <div class="grid gap-6 md:grid-cols-2">
          <div class="space-y-2">
            <p class:list={stateClass}>Domyślny</p>
            <Label for="ks-input-default">Nazwa składnika</Label>
            <Input id="ks-input-default" type="search" placeholder="np. mąka" />
          </div>
          <div class="space-y-2">
            <p class:list={stateClass}>Z wartością</p>
            <Label for="ks-input-value">Nazwa składnika</Label>
            <Input id="ks-input-value" type="search" value="mąka pszenna" />
          </div>
          <div class="space-y-2">
            <p class:list={stateClass}>Focus-visible (Tab do pola)</p>
            <Label for="ks-input-focus">Nazwa składnika</Label>
            <Input id="ks-input-focus" type="search" placeholder="Przejdź tu klawiszem Tab" />
          </div>
          <div class="space-y-2">
            <p class:list={stateClass}>Disabled</p>
            <Input id="ks-input-disabled" type="search" value="mąka" disabled class="peer" />
            <Label for="ks-input-disabled">Etykieta po polu (peer-disabled)</Label>
          </div>
          <div class="space-y-2">
            <p class:list={stateClass}>Błąd (aria-invalid)</p>
            <Label for="ks-input-invalid">Nazwa składnika</Label>
            <Input
              id="ks-input-invalid"
              type="search"
              value=""
              aria-invalid="true"
              aria-describedby="ks-input-invalid-msg"
            />
            <p id="ks-input-invalid-msg" class="text-sm text-destructive">
              Podaj nazwę składnika.
            </p>
          </div>
        </div>
      </section>

      <section class:list={sectionClass}>
        <h2 class:list={headingClass}>Lista wyboru (NativeSelect)</h2>
        <div class="grid gap-6 md:grid-cols-2">
          <div class="space-y-2">
            <p class:list={stateClass}>Domyślny / focus-visible (Tab)</p>
            <Label for="ks-select-default">Kategoria</Label>
            <NativeSelect id="ks-select-default" name="category">
              <option value="">Wszystkie kategorie</option>
              <option value="baking">Pieczenie</option>
              <option value="cooking">Gotowanie</option>
            </NativeSelect>
          </div>
          <div class="space-y-2">
            <p class:list={stateClass}>Disabled</p>
            <Label for="ks-select-disabled">Kategoria</Label>
            <NativeSelect id="ks-select-disabled" disabled>
              <option value="">Wszystkie kategorie</option>
            </NativeSelect>
          </div>
          <div class="space-y-2">
            <p class:list={stateClass}>Błąd (aria-invalid)</p>
            <Label for="ks-select-invalid">Składnik</Label>
            <NativeSelect id="ks-select-invalid" aria-invalid="true" aria-describedby="ks-select-invalid-msg">
              <option value="">Wybierz składnik</option>
              <option value="flour">mąka</option>
            </NativeSelect>
            <p id="ks-select-invalid-msg" class="text-sm text-destructive">
              Wybierz składnik z listy.
            </p>
          </div>
        </div>
      </section>

      <section class:list={sectionClass}>
        <h2 class:list={headingClass}>Przyciski (buttonVariants)</h2>
        <p class:list={stateClass}>
          Hover: najedź kursorem. Focus-visible: Tab. Klasy na natywnym &lt;button&gt; / &lt;a&gt;.
        </p>
        <div class="space-y-3">
          <div class="flex flex-wrap items-center gap-3">
            <button type="button" class:list={cn(buttonVariants(), focusRing)}>
              Szukaj (default)
            </button>
            <button type="button" class:list={cn(buttonVariants({ variant: "outline" }), focusRing)}>
              Oznacz jako najlepszy (outline)
            </button>
            <a href="#ks-buttons" class:list={cn(buttonVariants({ variant: "link" }), focusRing)}>
              Wróć do panelu (link)
            </a>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <button type="button" class:list={cn(buttonVariants({ size: "sm" }), focusRing)}>
              Default sm
            </button>
            <button type="button" class:list={cn(buttonVariants({ variant: "outline", size: "sm" }), focusRing)}>
              Oznacz jako najlepszy (outline sm)
            </button>
            <a id="ks-buttons" href="#ks-buttons" class:list={cn(buttonVariants(), focusRing)}>
              Dodaj składnik (link-CTA)
            </a>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <button type="button" disabled class:list={cn(buttonVariants(), focusRing)}>
              Disabled
            </button>
            <button type="button" disabled class:list={cn(buttonVariants({ variant: "outline" }), focusRing)}>
              Disabled outline
            </button>
          </div>
          <div class="max-w-xs">
            <button type="button" class:list={cn(buttonVariants(), focusRing, "w-full")}>
              Pełna szerokość (cn + w-full)
            </button>
          </div>
        </div>
      </section>

      <section class:list={sectionClass}>
        <h2 class:list={headingClass}>Komunikaty (Alert)</h2>
        <Alert role="status">Wpisz nazwę składnika albo wybierz go z listy, aby zobaczyć zamienniki. (default)</Alert>
        <Alert role="alert" variant="destructive">
          Nie udało się oznaczyć zamiennika. (destructive)
        </Alert>
        <Alert role="status" variant="success">
          Zmieniono najlepszy zamiennik. (success)
        </Alert>
      </section>

      <section class:list={sectionClass}>
        <h2 class:list={headingClass}>Plakietki (Badge)</h2>
        <div class="flex flex-wrap items-center gap-3">
          <Badge data-best-badge>Najlepszy</Badge>
          <Badge variant="outline">Outline</Badge>
        </div>
      </section>

      <section class:list={sectionClass}>
        <h2 class:list={headingClass}>Karta (Card)</h2>
        <Card>
          <p class="flex flex-wrap items-center gap-2 font-semibold">
            <span>Mąka orkiszowa</span>
            <Badge data-best-badge>Najlepszy</Badge>
          </p>
          <p class="text-sm text-muted-foreground">
            Proporcja: <span class="font-medium">1:1</span>
          </p>
          <button type="button" class:list={cn(buttonVariants({ variant: "outline", size: "sm" }), focusRing, "mt-2")}>
            Usuń wyróżnienie
          </button>
        </Card>
      </section>

      <section class:list={sectionClass}>
        <h2 class:list={headingClass}>Widok /ingredients</h2>
        <p class:list={stateClass}>
          Części widoku z <code>src/components/ingredients/</code> na fixturach (bez bazy). Formularze prowadzą do
          prawdziwych endpointów.
        </p>

        <p class:list={stateClass}>Pasek akcji i formularze</p>
        <div class:list={viewFrameClass}>
          <Card class:list={viewCardClass}>
            <IngredientsHeader />
            <LookupForms
              categories={fixtureCategories}
              ingredients={fixtureIngredients}
              query="mąka"
              mode="contains"
              viewCategory={null}
              ingredientParam=""
            />
            <IngredientsFooter />
          </Card>
        </div>

        <p class:list={stateClass}>Karta zwykła i karta najlepszego</p>
        <div class:list={viewFrameClass}>
          <Card class:list={viewCardClass}>
            <div class="space-y-4">
              <h2 class:list={headingClass}>{fixtureIngredient.name}</h2>
              <section class="space-y-3">
                <h3 class:list={headingClass}>{fixtureCategories[0].name}</h3>
                <ul class="space-y-3">
                  <SubstituteCard
                    substitute={fixtureBest}
                    ingredient={fixtureIngredient.id}
                    category=""
                    q=""
                    match="contains"
                  />
                  <SubstituteCard
                    substitute={fixtureRegular}
                    ingredient={fixtureIngredient.id}
                    category=""
                    q=""
                    match="contains"
                  />
                </ul>
              </section>
            </div>
          </Card>
        </div>

        <p class:list={stateClass}>Lista dopasowań</p>
        <div class:list={viewFrameClass}>
          <Card class:list={viewCardClass}>
            <section class="space-y-3">
              <h2 class:list={headingClass}>Pasujące składniki ({fixtureMatches.length})</h2>
              <ul class="space-y-2">
                {fixtureMatches.map((ingredient) => (
                  <li>
                    <Card class="bg-card/80">
                      <a href="#ks-view" class:list={cn(textLinkClass, "font-medium")}>
                        {ingredient.name}
                      </a>
                    </Card>
                  </li>
                ))}
              </ul>
            </section>
          </Card>
        </div>

        <p id="ks-view" class:list={stateClass}>
          Puste stany
        </p>
        <div class:list={viewFrameClass}>
          <Card class:list={cn(viewCardClass, "space-y-4")}>
            <EmptyState href="#ks-view" label="Dodaj pierwszy składnik">
              <p>Nie masz jeszcze żadnych składników.</p>
              <p class="mt-1">Dodaj pierwszy składnik z zamiennikiem, aby móc go tu wyszukać.</p>
            </EmptyState>
            <EmptyState>
              <p>Wpisz nazwę składnika albo wybierz go z listy, aby zobaczyć zamienniki.</p>
            </EmptyState>
            <EmptyState href="#ks-view" label="Dodaj składnik">
              <p>Nie znaleziono składnika „cukier trzcinowy”.</p>
            </EmptyState>
            <EmptyState href="#ks-view" label="Dodaj zamiennik">
              <p>Brak zamienników dla tego składnika.</p>
            </EmptyState>
          </Card>
        </div>

        <p class:list={stateClass}>Błąd przy karcie (error_for wskazuje wyświetloną kartę)</p>
        <div class:list={viewFrameClass}>
          <Card class:list={viewCardClass}>
            <ul class="space-y-3">
              <SubstituteCard
                substitute={fixtureErrorCard}
                ingredient={fixtureIngredient.id}
                category=""
                q=""
                match="contains"
                error={fixtureCardError}
              />
            </ul>
          </Card>
        </div>

        <p class:list={stateClass}>Błąd na górze (fallback: karty z error_for nie ma w widoku)</p>
        <div class:list={viewFrameClass}>
          <Card class:list={viewCardClass}>
            <Alert role="alert" variant="destructive" class="mb-4">
              {fixtureTopError}
            </Alert>
            <ul class="space-y-3">
              <SubstituteCard
                substitute={fixtureTopErrorCard}
                ingredient={fixtureIngredient.id}
                category=""
                q=""
                match="contains"
              />
            </ul>
          </Card>
        </div>

        <p class:list={stateClass}>
          Focus-visible (wymuszony do zrzutu: klasy focusRing / focusOutline bez wariantu focus-visible)
        </p>
        <div class:list={viewFrameClass}>
          <Card class:list={cn(viewCardClass, "space-y-4")}>
            <div class="space-y-2">
              <Label for="ks-forced-input">Nazwa składnika</Label>
              <Input id="ks-forced-input" type="search" value="mąka" class:list={forcedRing} />
            </div>
            <div class="space-y-2">
              <Label for="ks-forced-select">Kategoria</Label>
              <NativeSelect id="ks-forced-select" class:list={forcedRing}>
                <option value="">Wszystkie kategorie</option>
              </NativeSelect>
            </div>
            <div class="flex items-center gap-2 text-sm">
              <input id="ks-forced-radio" type="radio" checked class:list={cn("accent-primary", forcedOutline)} />
              <Label for="ks-forced-radio" class="font-normal">
                zawiera
              </Label>
            </div>
            <div class="flex flex-wrap items-center gap-3">
              <button type="button" class:list={cn(buttonVariants(), forcedRing)}>
                Szukaj
              </button>
              <button type="button" class:list={cn(buttonVariants({ variant: "outline", size: "sm" }), forcedRing)}>
                Oznacz jako najlepszy
              </button>
              <a href="#ks-view" class:list={cn(textLinkClass, forcedRing)}>
                Wróć do panelu
              </a>
            </div>
          </Card>
        </div>
      </section>

      <section class:list={sectionClass}>
        <h2 class:list={headingClass}>Macierz 7 stanów widoku /ingredients</h2>
        <p class:list={stateClass}>
          Kolejność tabulacji w widoku: „Dodaj składnik” → formularz wyszukiwania → formularz listy → karty → stopka
          („Wróć do panelu”, „Wyloguj się”).
        </p>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-left text-sm">
            <thead>
              <tr class="text-muted-foreground">
                <th scope="col" class:list={matrixCellClass}>
                  Stan
                </th>
                <th scope="col" class:list={matrixCellClass}>
                  W widoku
                </th>
                <th scope="col" class:list={matrixCellClass}>
                  Gdzie na tej stronie
                </th>
              </tr>
            </thead>
            <tbody>
              {stateMatrix.map((row) => (
                <tr>
                  <th scope="row" class:list={cn(matrixCellClass, "font-medium")}>
                    {row.state}
                  </th>
                  <td class:list={matrixCellClass}>{row.view}</td>
                  <td class:list={cn(matrixCellClass, "text-muted-foreground")}>{row.here}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </main>
</Layout>
