---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";
import { focusRing } from "@/components/ui/focus";

// Multi-line field, the Input.astro counterpart (new-york textarea on the same tokens). The value goes in as a
// prop and renders as the element's content; other attributes (maxlength, rows, name...) pass through.
type Props = Omit<HTMLAttributes<"textarea">, "value"> & { value?: string };

const { class: className, value = "", ...rest } = Astro.props;
---

<textarea
  class:list={cn(
    "flex field-sizing-content min-h-16 w-full min-w-0 rounded-md border border-input bg-card px-3 py-2 text-base text-foreground shadow-xs transition-[color,box-shadow] outline-none placeholder:text-muted-foreground disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 md:text-sm",
    focusRing,
    "aria-invalid:border-destructive aria-invalid:focus-visible:ring-destructive",
    className,
  )}
  {...rest}
>{value}</textarea>
