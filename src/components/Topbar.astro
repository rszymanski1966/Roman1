---
const { user } = Astro.locals;
---

<div class="mb-4 flex items-center justify-between rounded-xl border border-amber-900/10 bg-white/70 px-4 py-2 text-sm text-stone-700">
  {user ? (
    <>
      <span class="text-stone-600">{user.email}</span>
      <div class="flex items-center gap-3">
        <a href="/dashboard" class="text-orange-700 transition-colors hover:text-orange-900 hover:underline">
          Panel
        </a>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="text-orange-700 transition-colors hover:text-orange-900 hover:underline">
            Wyloguj się
          </button>
        </form>
      </div>
    </>
  ) : (
    <>
      <span class="text-stone-600">Nie jesteś zalogowany</span>
      <div class="flex gap-3">
        <a href="/auth/signin" class="text-orange-700 transition-colors hover:text-orange-900 hover:underline">
          Zaloguj się
        </a>
        <a href="/auth/signup" class="text-orange-700 transition-colors hover:text-orange-900 hover:underline">
          Załóż konto
        </a>
      </div>
    </>
  )}
</div>
