---
import EmptyState from "@/components/ingredients/EmptyState.astro";
import Alert from "@/components/ui/Alert.astro";
import Input from "@/components/ui/Input.astro";
import Label from "@/components/ui/Label.astro";
import { buttonVariants } from "@/components/ui/button";
import { focusRing } from "@/components/ui/focus";
import { MAX_NAME } from "@/lib/entry-fields";
import { type ListView, listRedirect } from "@/lib/list-view";
import { cn } from "@/lib/utils";
import type { IngredientListItem } from "@/types";

// The rename form of /ingredients/edit-ingredient (POST /api/ingredients/rename), or its not-found state.
interface Props {
  // null = unknown, foreign or malformed id: the not-found state with a link to the list, no form and no error.
  ingredient: IngredientListItem | null;
  // The list view to return to (hidden fields and the cancel link); null = the bare list.
  view: ListView | null;
  // Field value: the echo after an error, otherwise the saved name.
  name: string;
  // Error of the last save, shown above the form.
  error?: string | null;
  // Prefix of the field ids, so several forms can share a page (kitchen sink).
  idPrefix?: string;
}

const { ingredient, view, name, error = null, idPrefix = "rename" } = Astro.props;
const listHref = listRedirect(view);
const nameId = `${idPrefix}-name`;
const hintId = `${idPrefix}-hint`;
// One field, so a save error is always about the name.
const errorId = `${idPrefix}-error`;
---

{ingredient === null ? (
  <EmptyState href={listHref} label="Wróć do listy">
    <p>Nie znaleziono składnika.</p>
  </EmptyState>
) : (
  <div class="space-y-6">
    {error && (
      <Alert id={errorId} role="alert" variant="destructive">
        {error}
      </Alert>
    )}

    <form method="POST" action="/api/ingredients/rename" class="space-y-4">
      <input type="hidden" name="ingredient_id" value={ingredient.id} />
      <input type="hidden" name="ingredient" value={view?.ingredient ?? ""} />
      <input type="hidden" name="category" value={view?.category ?? ""} />
      <input type="hidden" name="q" value={view?.q ?? ""} />
      <input type="hidden" name="match" value={view?.match ?? ""} />

      <div class="space-y-2">
        <Label for={nameId}>Nazwa składnika</Label>
        <Input
          id={nameId}
          name="name"
          type="text"
          autocomplete="off"
          required
          maxlength={MAX_NAME}
          value={name}
          aria-invalid={error ? "true" : undefined}
          aria-describedby={error ? `${hintId} ${errorId}` : hintId}
        />
        {/* One ingredients row serves every category, so the rename is never per category. */}
        <p id={hintId} class="text-sm text-muted-foreground">
          Nazwa zmieni się we wszystkich kategoriach tego składnika.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3 pt-2">
        <button type="submit" class:list={cn(buttonVariants(), focusRing)}>
          Zapisz zmiany
        </button>
        <a href={listHref} class:list={cn(buttonVariants({ variant: "outline" }), focusRing)}>
          Anuluj
        </a>
      </div>
    </form>
  </div>
)}
