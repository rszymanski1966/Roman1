---
import Alert from "@/components/ui/Alert.astro";
import Badge from "@/components/ui/Badge.astro";
import Card from "@/components/ui/Card.astro";
import { buttonVariants } from "@/components/ui/button";
import { focusRing } from "@/components/ui/focus";
import { cn } from "@/lib/utils";
import type { MatchMode, SubstituteListItem } from "@/types";

// One substitute card (a list item) with the mark-as-best form, the edit link and the delete link.
// smoke.mjs relies on this markup: the name alone in its element (>name<), followed in the HTML by
// the hidden name="substitute_id" field, the data-best-badge attribute on the badge, and data-substitute-error
// on the card's error. The edit and delete links keep that intact: they never render the name as text (only in
// aria-label) and carry no name="substitute_id" field. The root id (substitute-<id>) is the anchor of
// /api/substitutes/best error redirects.
interface Props {
  substitute: SubstituteListItem;
  // The view to return to after the POST: shown ingredient id, the view's category (or ""), q and match.
  ingredient: string;
  category: string;
  q: string;
  match: MatchMode;
  // Error of the mark-as-best action for this card (the list matches ?error_for= against the shown cards).
  error?: string | null;
}

const { substitute, ingredient, category, q, match, error = null } = Astro.props;
const actionLabel = substitute.is_best ? "Usuń wyróżnienie" : "Oznacz jako najlepszy";
// The button points at its error, so a screen reader reads it with the button on focus.
const errorId = `substitute-${substitute.id}-error`;

// The edit page with this card's view, so saving or cancelling returns to it. Params in the order
// substitute, ingredient, category, q, match; empty values are left out (like withParams in index.astro).
const editParams = new URLSearchParams();
const editValues: [string, string][] = [
  ["substitute", substitute.id],
  ["ingredient", ingredient],
  ["category", category],
  ["q", q],
  ["match", match],
];
for (const [name, value] of editValues) {
  if (value) editParams.set(name, value);
}
const editHref = `/ingredients/edit-substitute?${editParams.toString()}`;
// The delete confirmation page takes the same view context.
const deleteHref = `/ingredients/delete-substitute?${editParams.toString()}`;
---

{/* scroll-mt keeps the anchored card off the very edge of the viewport. */}
<li id={`substitute-${substitute.id}`} class="scroll-mt-4">
  {/* The best card overrides the base border and background, so the classes are merged with cn(). */}
  <Card class:list={cn("bg-card/80", substitute.is_best && "border-primary bg-accent")}>
    <p class="flex flex-wrap items-center gap-2 font-semibold text-foreground">
      <span>{substitute.name}</span>
      {substitute.is_best && (
        <Badge data-best-badge class="rounded-full">
          Najlepszy
        </Badge>
      )}
    </p>
    <p class="text-sm text-foreground">
      Proporcja: <span class="font-medium">{substitute.ratio}</span>
    </p>
    {substitute.notes !== null && <p class="mt-1 text-sm text-muted-foreground">{substitute.notes}</p>}
    <div class="mt-2 flex flex-wrap items-center gap-2">
      <form method="POST" action="/api/substitutes/best">
        <input type="hidden" name="substitute_id" value={substitute.id} />
        <input type="hidden" name="is_best" value={substitute.is_best ? "0" : "1"} />
        <input type="hidden" name="ingredient" value={ingredient} />
        <input type="hidden" name="category" value={category} />
        <input type="hidden" name="q" value={q} />
        <input type="hidden" name="match" value={match} />
        {/* aria-label starts with the visible text and names the substitute, since every card has this button. */}
        <button
          type="submit"
          class:list={cn(buttonVariants({ variant: "outline", size: "sm" }), focusRing)}
          aria-label={`${actionLabel}: ${substitute.name}`}
          aria-describedby={error ? errorId : undefined}
        >
          {actionLabel}
        </button>
      </form>
      {/* Same aria-label pattern as the button: every card has this link. */}
      <a
        href={editHref}
        class:list={cn(buttonVariants({ variant: "outline", size: "sm" }), focusRing)}
        aria-label={`Edytuj: ${substitute.name}`}
      >
        Edytuj
      </a>
      {/* The destructive text colour must override the outline variant's hover text, so the classes are merged with cn(). */}
      <a
        href={deleteHref}
        class:list={cn(
          buttonVariants({ variant: "outline", size: "sm" }),
          focusRing,
          "text-destructive hover:text-destructive",
        )}
        aria-label={`Usuń: ${substitute.name}`}
      >
        Usuń
      </a>
    </div>
    {error && (
      <Alert id={errorId} role="alert" variant="destructive" class="mt-2" data-substitute-error>
        {error}
      </Alert>
    )}
  </Card>
</li>
