---
import Topbar from "@/components/Topbar.astro";

const { user } = Astro.locals;

const features = [
  {
    title: "Zamiennik w kilka sekund",
    description:
      "Wybierasz składnik i rodzaj potrawy, np. masło do ciasta, i od razu widzisz listę zamienników. Gdy niczego nie ma, możesz dodać pierwszy wpis.",
    icons: ["M3 11a8 8 0 1 0 16 0a8 8 0 1 0 -16 0", "m21 21-4.3-4.3"],
  },
  {
    title: "Proporcja i uwagi",
    description:
      "Przy każdym zamienniku zapisana jest proporcja zamiany oraz uwagi o wpływie na smak czy barwę, więc nie zepsujesz potrawy złą zamianą.",
    icons: ["M12 3v18", "m5 7 7-4 7 4", "M5 7l-3 7a3 3 0 0 0 6 0z", "m19 7-3 7a3 3 0 0 0 6 0z"],
  },
  {
    title: "Twoja prywatna baza",
    description:
      "Zamienniki budujesz sam, a dane każdego konta są odizolowane od pozostałych. Nikt poza Tobą ich nie zobaczy.",
    icons: ["M5 11h14a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2z", "M7 11V7a5 5 0 0 1 10 0v4"],
  },
];
---

<div class="relative min-h-screen w-full overflow-hidden bg-gradient-to-b from-amber-50 via-orange-50 to-amber-100">
  <!-- Warm glow -->
  <div class="pointer-events-none absolute top-0 left-1/2 h-[320px] w-[320px] -translate-x-1/2 rounded-full bg-orange-300/30 blur-[120px]"></div>
  <div class="pointer-events-none absolute top-2/3 -right-16 h-[260px] w-[260px] rounded-full bg-lime-300/20 blur-[100px]"></div>

  <div class="relative z-10 p-4 sm:p-8">
    <Topbar />

    <!-- Hero section -->
    <div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-6 text-center">
      <div class="mb-4 flex size-24 items-center justify-center rounded-full border border-orange-200 bg-white/70 text-orange-600 shadow-sm">
        <!-- Egg ⇄ banana (a classic egg substitute in baking), built from Lucide egg + banana with swap arrows.
             Scaled groups divide the stroke width by their scale, so every line keeps the 1.75 stroke. -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="56"
          height="56"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <g transform="translate(0.6 0.6) scale(0.44)" stroke-width="3.98">
            <path d="M12 2C8 2 4 8 4 14a8 8 0 0 0 16 0c0-6-4-12-8-12"></path>
          </g>
          <g transform="translate(12.2 12.2) scale(0.48)" stroke-width="3.65">
            <path d="M4 13c3.5-2 8-2 10 2a5.5 5.5 0 0 1 8 5"></path>
            <path d="M5.15 17.89c5.52-1.52 8.65-6.89 7-12C11.55 4 11.5 2 13 2c3.22 0 5 5.5 5 8 0 6.5-4.2 12-10.49 12C5.11 22 2 22 2 20c0-1.5 1.14-1.55 3.15-2.11Z"></path>
          </g>
          <path d="M14 4h4a2 2 0 0 1 2 2v4"></path>
          <path d="m17 7 3 3 3-3"></path>
          <path d="M10 20H6a2 2 0 0 1-2-2v-4"></path>
          <path d="m1 17 3-3 3 3"></path>
        </svg>
      </div>
      <h1 class="mb-6 text-5xl leading-tight font-bold text-stone-900 sm:text-6xl">
        Kuchenny <span class="text-orange-600">Zamiennik</span>
      </h1>
      <p class="mb-8 max-w-2xl text-lg text-stone-600 sm:text-xl">
        Brakuje składnika? Sprawdź własne, wypróbowane zamienniki z proporcją zamiany, dopasowane do rodzaju potrawy.
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        {user ? (
          <a
            href="/dashboard"
            class="inline-flex items-center justify-center rounded-lg bg-orange-600 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-orange-700"
          >
            Przejdź do panelu
          </a>
        ) : (
          <>
            <a
              href="/auth/signin"
              class="inline-flex items-center justify-center rounded-lg bg-orange-600 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-orange-700"
            >
              Zaloguj się
            </a>
            <a
              href="/auth/signup"
              class="inline-flex items-center justify-center rounded-lg border border-stone-300 bg-white/60 px-6 py-3 text-base font-medium text-stone-800 transition-colors hover:bg-white"
            >
              Załóż konto
            </a>
          </>
        )}
      </div>
    </div>

    <!-- Feature cards -->
    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 px-4 pb-24 sm:grid-cols-3">
      {features.map((feature) => (
        <div class="rounded-xl border border-amber-900/10 bg-white/70 p-6 shadow-sm backdrop-blur-xl">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="mb-4 text-orange-600"
            aria-hidden="true"
          >
            {feature.icons.map((d) => (
              <path d={d} />
            ))}
          </svg>
          <h3 class="mb-2 text-lg font-semibold text-stone-900">{feature.title}</h3>
          <p class="text-sm leading-relaxed text-stone-600">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</div>
