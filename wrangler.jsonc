{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kuchenny-zamiennik",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-08-28",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"not_found_handling": "404-page",
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true
		},
	},
	"workers_dev": true,
	"preview_urls": false,
}
